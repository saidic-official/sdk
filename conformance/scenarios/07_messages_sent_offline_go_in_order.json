{
  "name": "Messages sent while offline go once the network is back, in order",
  "says": "The network goes down; two messages sent meanwhile wait in the SDK's queue; when it comes back they are sent, each once and in the order they were written, and the history holds them so.",
  "steps": [
    {"op": "init"},
    {"op": "start", "args": {"text": "Before the network went"}, "save": {"conversation": "conversation_id"}},
    {"op": "open", "args": {"conversation_id": "$conversation"}},
    {"expect_event": {"type": "message.created", "message.from": "customer", "message.text": "Before the network went"}},
    {"op": "offline"},
    {"op": "send", "args": {"conversation_id": "$conversation", "text": "First while offline", "wait": false}, "expect_result": {"queued": true}},
    {"op": "send", "args": {"conversation_id": "$conversation", "text": "Second while offline", "wait": false}, "expect_result": {"queued": true}},
    {"op": "online"},
    {"expect_event": {"type": "message.created", "message.from": "customer", "message.text": "First while offline"}, "within": 20},
    {"expect_event": {"type": "message.created", "message.from": "customer", "message.text": "Second while offline"}, "within": 20},
    {"op": "history", "args": {"conversation_id": "$conversation"}, "expect_result": {"messages.length": 3, "messages.1.text": "First while offline", "messages.2.text": "Second while offline"}},
    {"expect_no_duplicates": true},
    {"op": "shutdown"}
  ]
}
